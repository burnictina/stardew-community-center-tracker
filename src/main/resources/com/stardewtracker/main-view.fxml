<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stardewtracker.controller.MainController">
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" styleClass="header" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="app-title" text="Stardew Community Center Tracker" />
            <Label prefHeight="17.0" prefWidth="34.0" text="Save:" />
            <ComboBox fx:id="saveComboBox" prefWidth="150.0" />
            <Button mnemonicParsing="false" onAction="#handleNewSave" text="New Save" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="100.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="section-title" text="Rooms" />
            <ListView fx:id="roomListView" prefHeight="320.0" prefWidth="190.0" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" styleClass="content-panel" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="roomTitleLabel" styleClass="room-title" text="Select a Room" />
            <ListView fx:id="bundleListView" prefHeight="240.0" prefWidth="200.0" />
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" styleClass="bundle-detail-card">
               <children>
                  <Label fx:id="bundleTitleLabel" styleClass="bundle-title" text="select a bundle" />
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="300.0" prefWidth="200.0" styleClass="item-scroll">
                     <content>
                        <FlowPane fx:id="itemContainer" hgap="10.0" prefHeight="300.0" prefWidth="200.0" vgap="10.0" />
                     </content>
                  </ScrollPane>
                  <Label fx:id="bundleProgressLabel" styleClass="bundle-progress" text="0 / 0 required" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" styleClass="footer" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="progressLabel" text="Progress : 0 / 0 (0%)" />
            <ProgressBar fx:id="progressBar" prefWidth="250.0" progress="0.0" />
            <Button mnemonicParsing="false" onAction="#handleSave" text="Save" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
